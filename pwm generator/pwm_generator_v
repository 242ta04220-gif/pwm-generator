module pwm_generator #(
    parameter COUNTER_WIDTH = 8
)(
    input  wire                         clk,
    input  wire                         reset,
    input  wire [COUNTER_WIDTH-1:0]     duty_cycle,
    output reg                          pwm_out
);

    reg [COUNTER_WIDTH-1:0] counter;

    always @(posedge clk or posedge reset) begin
        if (reset) begin
            counter <= 0;
            pwm_out <= 1'b0;
        end
        else begin
            counter <= counter + 1'b1;

            if (counter < duty_cycle)
                pwm_out <= 1'b1;
            else
                pwm_out <= 1'b0;
        end
    end

endmodule
